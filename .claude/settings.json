{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git init:*)",
      "Bash(git clean:*)",
      "Bash(git revert:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -a:*)",
      "Bash(git tag -d:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git stash push:*)",
      "PowerShell(git stash pop:*)",
      "PowerShell(git stash apply:*)",
      "PowerShell(git stash drop:*)",
      "PowerShell(git stash clear:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git init:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git am:*)",
      "PowerShell(git apply:*)",
      "PowerShell(git mv:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git branch -d:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git tag -a:*)",
      "PowerShell(git tag -d:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
