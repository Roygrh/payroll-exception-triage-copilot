# Copy to .env at the repository root and fill in. Never commit .env.
# This is the single environment file for the whole project: `uv run` from backend/ loads it,
# and docker compose passes it to the API container (env_file).

# Repository root override (only needed when the source tree is mounted elsewhere, e.g. containers)
# PTC_REPO_ROOT=/app

# LLM provider (ADR-016). Default: gpt-oss-20b on GroqCloud (free tier, no credit card) through the
# OpenAI-compatible adapter. Create a key in the GroqCloud console and paste it below.
PTC_LLM_PROVIDER=groq
PTC_LLM_BASE_URL=https://api.groq.com/openai/v1
PTC_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Free-tier pacing and retries (ADR-016): requests per minute, attempts on 429/5xx, timeout.
# PTC_LLM_RPM=30
# PTC_LLM_MAX_ATTEMPTS=5
# PTC_LLM_TIMEOUT_SECONDS=60
# PTC_LLM_MAX_OUTPUT_TOKENS=1200
# PTC_LLM_JSON_MODE=json_schema        # json_schema (strict) or json_object (fallback)
# PTC_LLM_REASONING_EFFORT=low         # sent to Groq's gpt-oss models; empty to omit

# Other OpenAI-compatible endpoints, by configuration only (same adapter):
# PTC_LLM_PROVIDER=openai
# PTC_LLM_BASE_URL=https://api.openai.com/v1
# PTC_LLM_MODEL=<model name>
# OPENAI_API_KEY=
#
# PTC_LLM_PROVIDER=ollama              # local server, no key
# PTC_LLM_BASE_URL=http://localhost:11434/v1
# PTC_LLM_MODEL=<local model name>
#
# PTC_LLM_PROVIDER=openai_compatible   # any other endpoint
# PTC_LLM_BASE_URL=
# PTC_LLM_MODEL=
# PTC_LLM_API_KEY=

# Optional alternative provider behind the same adapter interface (ADR-002, ADR-016):
# PTC_LLM_PROVIDER=anthropic
# PTC_LLM_MODEL=
# ANTHROPIC_API_KEY=

# Embeddings (ADR-017): small local model downloaded on first run (about 67 MB), no API key.
# PTC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PTC_EMBEDDING_DIM=384
# FASTEMBED_CACHE_PATH=                 # model cache folder (default: the system temp directory)

# Database (ADR-013): docker compose -f deployment/docker-compose.yml up db
DATABASE_URL=postgresql://ptc:ptc@localhost:5432/ptc

# Tracing (Iteration 6, ADR-004): US region host
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com
