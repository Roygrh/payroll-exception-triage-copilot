# Copy to .env and fill in. Never commit .env.

# Iteration 1: no services needed. Variables below are reserved for later iterations.

# Repository root override (only needed when the source tree is mounted elsewhere, e.g. containers)
# PTC_REPO_ROOT=/app

# LLM provider (Iteration 2, ADR-002)
# PTC_LLM_PROVIDER=anthropic
# PTC_LLM_MODEL=
# ANTHROPIC_API_KEY=

# Database (Iteration 2, ADR-013)
# DATABASE_URL=postgresql://ptc:ptc@localhost:5432/ptc

# Tracing (Iteration 6, ADR-004): US region host
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com
