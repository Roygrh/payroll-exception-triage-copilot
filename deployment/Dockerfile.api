# API container: Python 3.12 with uv (ADR-015). Build context is the repository root so the
# corpus, data and evals folders are available to the backend at /app (PTC_REPO_ROOT).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /uvx /bin/

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock backend/.python-version /app/backend/
WORKDIR /app/backend
RUN uv sync --frozen --no-dev --no-install-project

COPY backend /app/backend
COPY corpus /app/corpus
COPY data /app/data
COPY evals /app/evals
RUN uv sync --frozen --no-dev

ENV PTC_REPO_ROOT=/app
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "payroll_triage.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
